generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id              String      @id @default(uuid())
  name            String
  email           String?     @unique
  phone           String?     @unique
  passwordHash    String?
  isEmailVerified Boolean     @default(false)
  isActive        Boolean     @default(true)
  roles           UserRole[]
  customer        Customer?
  agent           Agent?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  perms RolePermission[]
  users UserRole[]
}

model Permission {
  id    String @id @default(uuid())
  key   String @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId         String
  permissionId   String
  role           Role @relation(fields: [roleId], references: [id])
  permission     Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String     @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
}

model OtpCode {
  id         String     @id @default(uuid())
  target     String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, purpose])
}

// ---------- Customers ----------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  id                  String           @id @default(uuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id])
  type                CustomerType     @default(INDIVIDUAL)
  businessAccountId   String?
  businessAccount     BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  addresses           Address[]
  shipments           Shipment[]
  orders              Order[]
  cartItems           CartItem[]
  @@index([businessAccountId])
}

model BusinessAccount {
  id            String             @id @default(uuid())
  legalName     String
  gstin         String?
  creditLimit   Decimal?          @db.Decimal(12, 2)
  isApproved    Boolean           @default(false)
  customers     Customer[]
  contracts     BusinessContract[]
}

model BusinessContract {
  id                  String         @id @default(uuid())
  businessAccountId   String
  businessAccount     BusinessAccount @relation(fields: [businessAccountId], references: [id])
  ruleJson            Json
  validFrom           DateTime
  validTo             DateTime?

  @@index([businessAccountId])
}

// ---------- Addresses & serviceability ----------

model Address {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  lat        Float?
  lng        Float?
  isSaved    Boolean   @default(false)

  @@index([customerId])
}

model City {
  id       String       @id @default(uuid())
  name     String       @unique
  state    String
  status   CityStatus   @default(INACTIVE)
  hubs     Hub[]
  pincodes Pincode[]
}

enum CityStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

model Pincode {
  id                 String  @id @default(uuid())
  pincode            String  @unique
  cityId             String
  city               City    @relation(fields: [cityId], references: [id])
  zone               String
  ownPickup          Boolean @default(false)
  ownDelivery        Boolean @default(false)
  partnerServiceable Boolean @default(true)

  @@index([cityId])
}

// ---------- Shipments ----------

enum ServiceType {
  LOCAL
  INTERCITY
  EXPRESS
  EXPRESS_PREMIUM
  AIRMAX
  LTL_FREIGHT
  FTL_FREIGHT
  INTERNATIONAL
  HYPERLOCAL
  SCHEDULED
  RETURN
}

/// Business use-case split (Own Network vs Partner Direct).
enum ShipmentType {
  BOOKSTORE_ORDER_SHIPMENT
  CUSTOMER_OWN_BOOK_SHIPMENT
  PARTNER_DIRECT_SHIPMENT
}

enum PackagingOption {
  CUSTOMER_PACKED
  COMPANY_PACKED
  COMPANY_PACKED_FRAGILE
  TEMPERATURE_CONTROLLED
}

enum PaymentMethod {
  PREPAID
  COD
  CORPORATE_CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CREDIT
}

model Shipment {
  id                  String           @id @default(uuid())
  awb                 String           @unique
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id])
  orderId             String?          @unique
  order               Order?           @relation(fields: [orderId], references: [id])
  pickupAddressId     String
  deliveryAddressId   String
  serviceType         ServiceType
  shipmentType        ShipmentType     @default(CUSTOMER_OWN_BOOK_SHIPMENT)
  packaging           PackagingOption  @default(CUSTOMER_PACKED)
  bookCount           Int
  parcelCount         Int              @default(1)
  declaredValue       Decimal?         @db.Decimal(12, 2)
  protectionOpted     Boolean          @default(false)
  paymentMethod       PaymentMethod    @default(PREPAID)
  codAmount           Decimal?         @db.Decimal(12, 2)
  codCollected        Boolean          @default(false)
  codRemitted         Boolean          @default(false)
  promoCode           String?
  discountAmount      Decimal          @default(0) @db.Decimal(12, 2)
  destinationCountry  String           @default("IN")
  ewayBillNumber      String?
  prohibitedConfirmed Boolean          @default(false)
  solutionCategory    String?
  goodsDescription    String?
  specialInstructions String?
  ndrAction           String?
  ndrRescheduledFor   DateTime?
  status              ShipmentStatus   @default(BOOKED)
  statusUpdatedAt     DateTime         @default(now())
  pickupSlotStart     DateTime?
  pickupSlotEnd       DateTime?
  estimatedDeliveryAt DateTime?
  paymentStatus       PaymentStatus    @default(PENDING)
  packages            Package[]
  items               ShipmentItem[]
  legs                ShipmentLeg[]
  events              TrackingEvent[]
  financial           ShipmentFinancial?
  payments            Payment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
}

model Package {
  id                 String   @id @default(uuid())
  shipmentId         String
  shipment           Shipment @relation(fields: [shipmentId], references: [id])
  actualWeightKg     Decimal  @db.Decimal(8, 3)
  lengthCm           Decimal  @db.Decimal(8, 2)
  widthCm            Decimal  @db.Decimal(8, 2)
  heightCm           Decimal  @db.Decimal(8, 2)
  chargeableWeightKg Decimal  @db.Decimal(8, 3)
  barcode            String   @unique // awb + "-" + index

  @@index([shipmentId])
}

model ShipmentItem {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  title      String?
  isbn       String?
  quantity   Int      @default(1)
  isFragile  Boolean  @default(false)

  @@index([shipmentId])
}

enum CarrierType {
  OWN
  PARTNER
}

enum LegStatus {
  PLANNED
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model ShipmentLeg {
  id                 String        @id @default(uuid())
  shipmentId         String
  shipment           Shipment      @relation(fields: [shipmentId], references: [id])
  sequence           Int
  carrierType        CarrierType
  carrierId          String?
  carrier            Carrier?      @relation(fields: [carrierId], references: [id])
  externalAwb        String?
  labelUrl           String?
  originLabel        String
  destinationLabel   String
  status             LegStatus     @default(PLANNED)
  partnerCost        Decimal?      @db.Decimal(12, 2)
  events             TrackingEvent[]

  @@unique([shipmentId, sequence])
  @@index([carrierId])
}

// ---------- Tracking ----------

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  PICKUP_FAILED
  PICKED_UP
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  RTO_INITIATED
  RTO_IN_TRANSIT
  RTO_DELIVERED
  CANCELLED
  LOST
}

enum EventKind {
  STATUS
  EXCEPTION
  NOTE
}

enum EventSource {
  AGENT_APP
  ADMIN
  PARTNER_WEBHOOK
  PARTNER_POLL
  SYSTEM
}

model TrackingEvent {
  id               String          @id @default(uuid())
  shipmentId       String
  shipment         Shipment        @relation(fields: [shipmentId], references: [id])
  legId            String?
  leg              ShipmentLeg?    @relation(fields: [legId], references: [id])
  kind             EventKind       @default(STATUS)
  status           ShipmentStatus?
  exceptionCode    String?
  rawStatus        String?
  source           EventSource
  actorUserId      String?
  carrierId        String?
  externalEventId  String?
  locationLabel    String?
  lat              Float?
  lng              Float?
  remarks          String?
  proofUrl         String?
  appliedToStatus  Boolean         @default(false)
  flagged          Boolean        @default(false)
  eventTime        DateTime
  createdAt        DateTime       @default(now())

  @@unique([carrierId, externalEventId])
  @@index([shipmentId, eventTime])
}

model StatusMapping {
  id             String
  carrierId      String
  rawStatus      String
  internalStatus ShipmentStatus?
  exceptionCode  String?

  @@id([id])
  @@unique([carrierId, rawStatus])
}

// ---------- Carriers ----------

model Carrier {
  id             String       @id @default(uuid())
  code           String       @unique // OWN, MOCK, DELHIVERY, SHIPROCKET
  name           String
  type           CarrierType
  isEnabled      Boolean      @default(false)
  credentialsEnc String?
  webhookSecretEnc String?
  settings       Json?
  legs           ShipmentLeg[]
}

model CarrierRateCard {
  id          String      @id @default(uuid())
  carrierId   String
  originZone  String
  destZone    String
  serviceType ServiceType
  maxWeightKg Decimal     @db.Decimal(8, 3)
  price       Decimal     @db.Decimal(12, 2)
  etaDays     Int

  @@index([carrierId])
}

// ---------- Operations ----------

model Agent {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  cityId     String
  isOnline   Boolean  @default(false)
  tasks      Task[]

  @@index([cityId])
}

enum TaskType {
  PICKUP
  DELIVERY
  RTO_RETURN
  HUB_TRANSFER
}

enum TaskStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id            String     @id @default(uuid())
  type          TaskType
  shipmentId    String
  agentId       String?
  agent         Agent?     @relation(fields: [agentId], references: [id])
  status        TaskStatus @default(ASSIGNED)
  scheduledFor  DateTime?
  failureReason String?
  attemptNo     Int        @default(1)
  proofUrl      String?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  @@index([agentId, status])
  @@index([shipmentId])
}

model DeliveryOtp {
  id         String    @id @default(uuid())
  shipmentId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?

  @@index([shipmentId])
}

model Hub {
  id      String    @id @default(uuid())
  name    String
  cityId  String
  city    City      @relation(fields: [cityId], references: [id])
  address String
  scans   HubScan[]

  @@index([cityId])
}

model HubScan {
  id            String   @id @default(uuid())
  hubId         String
  hub           Hub      @relation(fields: [hubId], references: [id])
  shipmentId    String
  direction     String
  scannedBy     String
  conditionNote String?
  scannedAt     DateTime @default(now())

  @@index([hubId])
}

model Vehicle {
  id        String
  regNo     String   @unique
  type      String
  capacityKg Int
  cityId    String

  @@id([id])
}

model Manifest {
  id                 String         @id @default(uuid())
  code               String         @unique
  originHubId        String
  destinationLabel   String
  vehicleId          String?
  carrierId          String?
  status             String         @default("OPEN")
  items              ManifestItem[]
  createdAt          DateTime       @default(now())
  closedAt           DateTime?
}

model ManifestItem {
  manifestId String
  shipmentId String
  manifest   Manifest @relation(fields: [manifestId], references: [id])

  @@id([manifestId, shipmentId])
}

// ---------- Pricing ----------

model PricingRule {
  id         String      @id @default(uuid())
  serviceType ServiceType
  originZone String
  destZone   String
  maxWeightKg Decimal    @db.Decimal(8, 3)
  price      Decimal     @db.Decimal(12, 2)
  etaDays    Int
  isActive   Boolean     @default(true)
}

model PricingConfig {
  id    String @id @default(uuid())
  key   String @unique
  value Json
}

// ---------- Finance ----------

model Payment {
  id                 String      @id @default(uuid())
  shipmentId         String
  shipment           Shipment    @relation(fields: [shipmentId], references: [id])
  provider           String
  providerOrderId    String?
  providerPaymentId String?
  amount             Decimal     @db.Decimal(12, 2)
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime    @default(now())

  @@index([shipmentId])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  providerRefundId String?
  createdAt       DateTime @default(now())
}

model ShipmentFinancial {
  id             String   @id @default(uuid())
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id])
  customerPrice  Decimal  @db.Decimal(12, 2)
  tax            Decimal  @db.Decimal(12, 2)
  partnerCost    Decimal  @default(0) @db.Decimal(12, 2)
  ownCost        Decimal  @default(0) @db.Decimal(12, 2)
  refunded       Decimal  @default(0) @db.Decimal(12, 2)
}

model Invoice {
  id                 String   @id @default(uuid())
  number             String   @unique
  shipmentId         String?
  businessAccountId  String?
  pdfUrl             String?
  total              Decimal  @db.Decimal(12, 2)
  issuedAt           DateTime @default(now())
}

// ---------- Support, comms, governance ----------

model Ticket {
  id           String   @id @default(uuid())
  shipmentId   String?
  customerId   String
  subject      String
  status       String   @default("OPEN")
  type         String   @default("COMPLAINT")
  messages     TicketMessage[]
  createdAt    DateTime @default(now())
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model Notification {
  id         String   @id @default(uuid())
  shipmentId String?
  channel    String
  target     String
  template   String
  status     String   @default("QUEUED")
  payload    Json?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  entity       String
  entityId     String
  before       Json?
  after        Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
}

model WebhookLog {
  id          String   @id @default(uuid())
  carrierCode String
  headers     Json?
  body        Json
  processed   Boolean  @default(false)
  error       String?
  receivedAt  DateTime @default(now())
}

// ---------- Idempotency ----------

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique // client-provided Idempotency-Key, scoped to scope+user
  scope        String   // e.g. "shipments.create", "payments.create-order"
  userId       String?
  requestBody  Json
  responseJson Json
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())

  @@index([scope, userId])
}

// ---------- Promos, Enterprise Inquiries & Partner API Keys ----------

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String
  discountType   String    @default("PERCENT") // PERCENT | FLAT
  discountValue  Decimal   @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  minOrderAmount Decimal   @default(0) @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int       @default(0)
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model LogisticsInquiry {
  id               String   @id @default(uuid())
  userId           String?
  customerName     String
  email            String
  phone            String
  companyName      String?
  solutionType     String   // 3PL_WAREHOUSING | FTL_CHARTER | FRANCHISE_PARTNER | TEMPERATURE_CONTROLLED | ONDC_ECOMMERCE | B2B_CONTRACT
  originCity       String?
  destCity         String?
  monthlyVolume    String?
  temperatureRange String?
  notes            String
  status           String   @default("NEW") // NEW | CONTACTED | QUOTED | ACTIVE | CLOSED
  adminNotes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([solutionType, status])
}

model PartnerApiKey {
  id                String    @id @default(uuid())
  userId            String
  businessAccountId String?
  label             String
  keyPrefix         String
  keyHash           String    @unique
  webhookUrl        String?
  ondcSubscriberId  String?
  isActive          Boolean   @default(true)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([businessAccountId])
}

// ---------- Bookstore e-commerce (Phase 1 scaffolding) ----------

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  products  Product[]
}

model Product {
  id            String   @id @default(uuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  title         String
  isbn          String?  @unique
  author        String?
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  weightGrams   Int      @default(400)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  orderNo       String      @unique // human-readable, e.g. ORD-2611-0001
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(12, 2)
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  items         OrderItem[]
  shipment      Shipment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

model AwbSequence {
  ym String @id
  v  Int

  @@map("awb_sequence")
}
