NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://courier:courier@localhost:5432/book_courier
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3000
# OWN_ONLY | PARTNER_ONLY | AUTO_OPTIMIZED
ROUTING_STRATEGY=AUTO_OPTIMIZED
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
EMAIL_PROVIDER=console
EMAIL_WEBHOOK_URL=
# Rate limit overrides (requests per window; defaults tighten automatically in NODE_ENV=production)
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_PUBLIC_MAX=60
# RATE_LIMIT_API_MAX=240
# Payment gateway: leave RAZORPAY_KEY_ID empty to run the built-in dev mock
# gateway (no network calls); set key+secret+webhook secret for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
